From 35a3c1364c8323fd33ed6396a43df167b3e05d63 Mon Sep 17 00:00:00 2001
From: Alex Nadtochiy <88209939+aleksn7@users.noreply.github.com>
Date: Tue, 18 Aug 2026 19:10:01 +0300
Subject: [PATCH] fix: Fix segfault during shutdown when using Triton metrics
 in Python backend (#429)

Stub::~Stub() released async_event_loop_, background_futures_ and
model_instance_ while holding the GIL, but the serialize_bytes_ and
deserialize_bytes_ members were destroyed afterwards without it. At
shutdown every stub then segfaulted in _Py_Dealloc, seen on Jetson
Thor with Python 3.14:

  _Py_Dealloc
  pybind11::object::~object
  Stub::~Stub() pb_stub.cc:1074
  main / Stub::DestroyInstance()

Release all five Python objects under the GIL, from both
Stub::DestroyInstance() and the destructor.

Upstream-Status: Backport [https://github.com/triton-inference-server/python_backend/commit/35a3c1364c8323fd33ed6396a43df167b3e05d63]
Signed-off-by: Ilies CHERGUI <ichergui@nvidia.com>
---
 src/pb_stub.cc | 27 ++++++++++++++++++++-------
 src/pb_stub.h  |  5 +++++
 2 files changed, 25 insertions(+), 7 deletions(-)

diff --git a/src/pb_stub.cc b/src/pb_stub.cc
index cd19f3e..92b5bbd 100644
--- a/src/pb_stub.cc
+++ b/src/pb_stub.cc
@@ -1059,13 +1059,7 @@ Stub::~Stub()
   }
 #endif
 
-  // Ensure the interpreter is active before trying to clean up.
-  if (Py_IsInitialized()) {
-    py::gil_scoped_acquire acquire;
-    py::object async_event_loop_local(std::move(async_event_loop_));
-    py::object background_futures_local(std::move(background_futures_));
-    py::object model_instance_local(std::move(model_instance_));
-  }
+  DestroyPythonObjects();
 
   stub_message_queue_.reset();
   parent_message_queue_.reset();
@@ -1088,6 +1082,11 @@ Stub::GetOrCreateInstance()
 void
 Stub::DestroyInstance()
 {
+  if (!stub_instance) {
+    return;
+  }
+
+  stub_instance->DestroyPythonObjects();
   stub_instance.reset();
 }
 
@@ -1511,6 +1510,20 @@ Stub::GetCUDAMemoryPoolAddress(std::unique_ptr<IPCMessage>& ipc_message)
 #endif
 }
 
+void
+Stub::DestroyPythonObjects()
+{
+  // Ensure the interpreter is active before trying to clean up.
+  if (Py_IsInitialized()) {
+    py::gil_scoped_acquire acquire;
+    py::object async_event_loop_local(std::move(async_event_loop_));
+    py::object background_futures_local(std::move(background_futures_));
+    py::object model_instance_local(std::move(model_instance_));
+    py::object deserialize_bytes_local(std::move(deserialize_bytes_));
+    py::object serialize_bytes_local(std::move(serialize_bytes_));
+  }
+}
+
 void
 Stub::ProcessBLSResponseDecoupled(std::unique_ptr<IPCMessage>& ipc_message)
 {
diff --git a/src/pb_stub.h b/src/pb_stub.h
index e39014f..b2a9717 100644
--- a/src/pb_stub.h
+++ b/src/pb_stub.h
@@ -267,6 +267,11 @@ class Stub {
   /// Get the CUDA memory pool address from the parent process.
   void GetCUDAMemoryPoolAddress(std::unique_ptr<IPCMessage>& ipc_message);
 
+  /// Cleans up Python objects and must be called before the destructor.
+  /// This prevents problems that occur when Python object destructors
+  /// call Stub::GetOrCreateInstance.
+  void DestroyPythonObjects();
+
   /// Calls the user's is_ready() Python method and returns its response
   /// when handling model readiness check requests.
   void ProcessUserModelReadinessRequest(
