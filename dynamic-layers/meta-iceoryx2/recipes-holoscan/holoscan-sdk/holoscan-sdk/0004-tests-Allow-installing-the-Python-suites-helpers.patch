From 7b87af21e9c6174ca36dd20800c575349fac5397 Mon Sep 17 00:00:00 2001
From: Ilies CHERGUI <ichergui@nvidia.com>
Date: Thu, 1 Oct 2026 14:46:19 -0700
Subject: [PATCH] tests: Allow installing the Python suites' helpers

The Python ctests run helper programs, fixture libraries and generated
schema packages by build-tree path, which HOLOSCAN_INSTALL_TESTS_DIR does
not install. A distribution replaying them on a target would have to copy
those binaries out of the build tree and rewrite their RPATH itself.

Add holoscan_install_test_helpers() to install them as component
holoscan-tests under helpers/, at the path the build tree gives them, so a
runner can map each build-tree path onto its installed copy by prefix and
CMake sets the install RPATH. They stay out of the suites' own directory,
where a runner executes every program as a suite.

Also install python_core_session_reaper_test with the other suites, and build
holoscan_test_support, byte_schema_support and the constructor-handle provider
with NOSTRIP, as the
SDK's installed nanobind modules are, so they keep their symbols for a debug
package.

Upstream-Status: Pending
Signed-off-by: Ilies CHERGUI <ichergui@nvidia.com>
---
diff --git a/cmake/modules/HoloscanInstallTests.cmake b/cmake/modules/HoloscanInstallTests.cmake
index 05c881880..6c6f6e6ce 100644
--- a/cmake/modules/HoloscanInstallTests.cmake
+++ b/cmake/modules/HoloscanInstallTests.cmake
@@ -58,3 +58,63 @@ function(holoscan_install_test_targets)
         )
     endforeach()
 endfunction()
+
+# Install what the Python suites run by path rather than import: helper programs,
+# fixture libraries and generated schema packages. Each goes under helpers/,
+# at the path the build tree gives it relative to the top-level build directory,
+# so a runner can map any build-tree path onto the installed copy by prefix.
+# helpers/ keeps them out of the suites' own directory, where a runner treats
+# every program as a suite.
+#
+#   TARGETS  executables, shared libraries and Python extension modules
+#   SCHEMAS  holoscan_add_flatbuffer_schema(... PYTHON) targets: their generated
+#            module, its stub, and its codec extension
+function(holoscan_install_test_helpers)
+    if(NOT HOLOSCAN_INSTALL_TESTS_DIR)
+        return()
+    endif()
+    cmake_parse_arguments(_hith "" "" "TARGETS;SCHEMAS" ${ARGN})
+    set(_hith_root "${HOLOSCAN_INSTALL_TESTS_DIR}/helpers")
+
+    foreach(_hith_target IN LISTS _hith_TARGETS)
+        get_target_property(_hith_type ${_hith_target} TYPE)
+        if(_hith_type STREQUAL "EXECUTABLE")
+            get_target_property(_hith_dir ${_hith_target} RUNTIME_OUTPUT_DIRECTORY)
+        else()
+            get_target_property(_hith_dir ${_hith_target} LIBRARY_OUTPUT_DIRECTORY)
+        endif()
+        if(NOT _hith_dir)
+            get_target_property(_hith_dir ${_hith_target} BINARY_DIR)
+        endif()
+        file(RELATIVE_PATH _hith_relative "${holoscan_BINARY_DIR}" "${_hith_dir}")
+        install(TARGETS ${_hith_target}
+            COMPONENT holoscan-tests
+            RUNTIME DESTINATION "${_hith_root}/${_hith_relative}"
+            LIBRARY DESTINATION "${_hith_root}/${_hith_relative}"
+        )
+    endforeach()
+
+    foreach(_hith_schema IN LISTS _hith_SCHEMAS)
+        get_target_property(_hith_module ${_hith_schema} HOLOSCAN_FLATBUFFER_PYTHON_MODULE)
+        get_target_property(_hith_stub ${_hith_schema} HOLOSCAN_FLATBUFFER_PYTHON_STUB)
+        get_target_property(_hith_codec ${_hith_schema} HOLOSCAN_FLATBUFFER_PYTHON_CODEC_TARGET)
+        if(NOT _hith_module OR NOT _hith_codec)
+            message(FATAL_ERROR
+                "holoscan_install_test_helpers: ${_hith_schema} has no Python codec")
+        endif()
+        get_filename_component(_hith_dir "${_hith_module}" DIRECTORY)
+        file(RELATIVE_PATH _hith_relative "${holoscan_BINARY_DIR}" "${_hith_dir}")
+        set(_hith_files "${_hith_module}")
+        if(_hith_stub)
+            list(APPEND _hith_files "${_hith_stub}")
+        endif()
+        install(FILES ${_hith_files}
+            COMPONENT holoscan-tests
+            DESTINATION "${_hith_root}/${_hith_relative}"
+        )
+        install(TARGETS ${_hith_codec}
+            COMPONENT holoscan-tests
+            LIBRARY DESTINATION "${_hith_root}/${_hith_relative}"
+        )
+    endforeach()
+endfunction()
diff --git a/examples/flatbuffer_schemas/descriptor_tensor_external_topic/cpp/CMakeLists.txt b/examples/flatbuffer_schemas/descriptor_tensor_external_topic/cpp/CMakeLists.txt
index 818f6da36..7222910bf 100644
--- a/examples/flatbuffer_schemas/descriptor_tensor_external_topic/cpp/CMakeLists.txt
+++ b/examples/flatbuffer_schemas/descriptor_tensor_external_topic/cpp/CMakeLists.txt
@@ -64,6 +64,11 @@ if(BUILD_TESTING)
         )
 
         if(HOLOSCAN_BUILD_PYTHON_EXAMPLES)
+            # The Python client of EXAMPLE_PYTHON_DESCRIPTOR_TENSOR_EXTERNAL_TOPIC_TEST
+            # imports this generated schema package.
+            if(COMMAND holoscan_install_test_helpers)
+                holoscan_install_test_helpers(SCHEMAS descriptor_tensor_external_topic_generated)
+            endif()
             get_target_property(
                 _HOLOSCAN_DESCRIPTOR_TOPIC_PYTHON_DIR
                 descriptor_tensor_external_topic_generated
diff --git a/modules/inference/python/CMakeLists.txt b/modules/inference/python/CMakeLists.txt
index edb66de63..78fc68954 100644
--- a/modules/inference/python/CMakeLists.txt
+++ b/modules/inference/python/CMakeLists.txt
@@ -74,6 +74,9 @@ if(HOLOSCAN_BUILD_TESTS AND BUILD_TESTING)
     holoscan_configure_cxx20_target(holoscan_inference_python_plan PRIVATE)
     target_link_libraries(holoscan_inference_python_plan PRIVATE holoscan::op_inference)
     add_dependencies(holoscan-python holoscan_inference_python_plan)
+    if(COMMAND holoscan_install_test_helpers)
+        holoscan_install_test_helpers(TARGETS holoscan_inference_python_plan)
+    endif()
 
     add_test(NAME python-inference.bindings
         COMMAND "${Python3_EXECUTABLE}" -m pytest -q
