 # Append local cmake dependency path CMAKE_PREFIX_PATH
 list(APPEND CMAKE_PREFIX_PATH "${CMAKE_CURRENT_LIST_DIR}/cmake/deps")
 
diff --git a/cmake/modules/HoloscanInstallTests.cmake b/cmake/modules/HoloscanInstallTests.cmake
new file mode 100644
index 000000000..05c881880
--- /dev/null
+++ b/cmake/modules/HoloscanInstallTests.cmake
@@ -0,0 +1,60 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+#
+# HOLOSCAN_BUILD_TESTS builds the test tree but no install component ships it.
+# Setting HOLOSCAN_INSTALL_TESTS_DIR installs the self-contained suites instead,
+# letting CMake rewrite their RPATH as for any other installed target.
+#
+# STRING, not PATH: cmake absolutises a relative PATH cache value against the
+# build directory, while install() wants one relative to the prefix.
+set(HOLOSCAN_INSTALL_TESTS_DIR "" CACHE STRING
+    "Destination, relative to the install prefix, for the installed test suites")
+
+# Install every executable and shared library in the calling directory as component
+# holoscan-tests. Sweeping rather than naming targets picks up suites added later
+# and carries the plugins they dlopen beside themselves via $ORIGIN. SUBDIRECTORY
+# keeps a directory's programs apart, for suites that are not run whole but
+# through their ctest entries, or that ship helper programs. TARGETS installs only
+# the named targets, for a directory that also builds programs which are not
+# suites: a runner executes every program in the destination as one.
+function(holoscan_install_test_targets)
+    if(NOT HOLOSCAN_INSTALL_TESTS_DIR)
+        return()
+    endif()
+    cmake_parse_arguments(ARG "" "SUBDIRECTORY" "TARGETS" ${ARGN})
+    set(_holoscan_test_destination "${HOLOSCAN_INSTALL_TESTS_DIR}")
+    if(ARG_SUBDIRECTORY)
+        string(APPEND _holoscan_test_destination "/${ARG_SUBDIRECTORY}")
+    endif()
+
+    if(ARG_TARGETS)
+        set(_holoscan_test_targets ${ARG_TARGETS})
+    else()
+        get_property(_holoscan_test_targets
+            DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
+            PROPERTY BUILDSYSTEM_TARGETS
+        )
+    endif()
+
+    foreach(_holoscan_test_target IN LISTS _holoscan_test_targets)
+        get_target_property(_holoscan_test_target_type ${_holoscan_test_target} TYPE)
+        if(NOT (_holoscan_test_target_type STREQUAL "EXECUTABLE" OR
+                _holoscan_test_target_type STREQUAL "SHARED_LIBRARY"))
+            continue()
+        endif()
+
+        # Never built, so there is no binary to install: the expected_compile_fail_*
+        # fixtures are ill-formed on purpose.
+        get_target_property(_holoscan_test_target_excluded
+            ${_holoscan_test_target} EXCLUDE_FROM_ALL)
+        if(_holoscan_test_target_excluded)
+            continue()
+        endif()
+
+        install(TARGETS ${_holoscan_test_target}
+            COMPONENT holoscan-tests
+            RUNTIME DESTINATION "${_holoscan_test_destination}"
+            LIBRARY DESTINATION "${_holoscan_test_destination}"
+        )
+    endforeach()
+endfunction()
diff --git a/modules/inference/tests/CMakeLists.txt b/modules/inference/tests/CMakeLists.txt
index 104d139a1..c77c5bde8 100644
--- a/modules/inference/tests/CMakeLists.txt
+++ b/modules/inference/tests/CMakeLists.txt
@@ -134,3 +134,17 @@ holoscan_add_installed_consumer_test(
         "-DHOLOSCAN_BUILD_EXAMPLES=${HOLOSCAN_BUILD_EXAMPLES}"
         "-DHOLOSCAN_MODULE_PACKAGE_DIR=${CMAKE_INSTALL_LIBDIR}/cmake/${HOLOSCAN_PACKAGE_NAME}"
 )
+
+# Ship these suites when the build opts into installing tests, with the models they
+# read from modules/inference/tests/test_models relative to their working
+# directory: install that tree beside them, where a runner starting them from the
+# suites' directory finds it.
+if(COMMAND holoscan_install_test_targets)
+    holoscan_install_test_targets()
+    if(HOLOSCAN_INSTALL_TESTS_DIR)
+        install(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/test_models"
+            COMPONENT holoscan-tests
+            DESTINATION "${HOLOSCAN_INSTALL_TESTS_DIR}/modules/inference/tests"
+        )
+    endif()
+endif()
