diff --git a/tests/channel/CMakeLists.txt b/tests/channel/CMakeLists.txt
index a92cac002..8e67baaf6 100644
--- a/tests/channel/CMakeLists.txt
+++ b/tests/channel/CMakeLists.txt
@@ -30,6 +30,17 @@ function(holoscan_add_channel_expected_compile_fail_test
         "${target_name}" "${diagnostic_fragment}")
 endfunction()
 
+# The suites exec their child programs by path. An installed suite execs the
+# installed children, in channel/; the build-tree ones are not there.
+function(holoscan_channel_child_exe out_var target)
+    if(HOLOSCAN_INSTALL_TESTS_DIR)
+        set(${out_var}
+            "${CMAKE_INSTALL_PREFIX}/${HOLOSCAN_INSTALL_TESTS_DIR}/channel/${target}" PARENT_SCOPE)
+    else()
+        set(${out_var} "$<TARGET_FILE:${target}>" PARENT_SCOPE)
+    endif()
+endfunction()
+
 add_library(channel_process_test_support STATIC
     channel_test_support.cpp
 )
@@ -176,12 +187,18 @@ target_link_libraries(channel_event_wait_child
         holoscan::core
         holomq::holomq
 )
+holoscan_channel_child_exe(_channel_interprocess_child channel_interprocess_child)
+holoscan_channel_child_exe(_channel_catalog_pod_child channel_catalog_pod_interprocess_child)
+holoscan_channel_child_exe(_channel_event_wait_child channel_event_wait_child)
 target_compile_definitions(channel_test
     PRIVATE
-        HOLOSCAN_CHANNEL_INTERPROCESS_CHILD_EXE="$<TARGET_FILE:channel_interprocess_child>"
-        HOLOSCAN_CHANNEL_CATALOG_POD_INTERPROCESS_CHILD_EXE="$<TARGET_FILE:channel_catalog_pod_interprocess_child>"
-        HOLOSCAN_CHANNEL_EVENT_WAIT_CHILD_EXE="$<TARGET_FILE:channel_event_wait_child>"
+        HOLOSCAN_CHANNEL_INTERPROCESS_CHILD_EXE="${_channel_interprocess_child}"
+        HOLOSCAN_CHANNEL_CATALOG_POD_INTERPROCESS_CHILD_EXE="${_channel_catalog_pod_child}"
+        HOLOSCAN_CHANNEL_EVENT_WAIT_CHILD_EXE="${_channel_event_wait_child}"
 )
+unset(_channel_interprocess_child)
+unset(_channel_catalog_pod_child)
+unset(_channel_event_wait_child)
 add_dependencies(channel_test
     channel_catalog_pod_interprocess_child
     channel_event_wait_child
@@ -258,10 +275,12 @@ target_link_libraries(channel_schema_interprocess_child
         holoscan::sensor_io
         holomq::holomq
 )
+holoscan_channel_child_exe(_channel_schema_child channel_schema_interprocess_child)
 target_compile_definitions(channel_schema_test
     PRIVATE
-        HOLOSCAN_CHANNEL_SCHEMA_INTERPROCESS_CHILD_EXE="$<TARGET_FILE:channel_schema_interprocess_child>"
+        HOLOSCAN_CHANNEL_SCHEMA_INTERPROCESS_CHILD_EXE="${_channel_schema_child}"
 )
+unset(_channel_schema_child)
 add_dependencies(channel_schema_test
     channel_schema_interprocess_child
 )
@@ -300,14 +319,16 @@ target_link_libraries(channel_tensor_interprocess_child
         holoscan::core
         holomq::holomq
 )
+holoscan_channel_child_exe(_channel_tensor_child channel_tensor_interprocess_child)
 target_compile_definitions(channel_tensor_test
     PRIVATE
-        HOLOSCAN_CHANNEL_TENSOR_INTERPROCESS_CHILD_EXE="$<TARGET_FILE:channel_tensor_interprocess_child>"
+        HOLOSCAN_CHANNEL_TENSOR_INTERPROCESS_CHILD_EXE="${_channel_tensor_child}"
 )
 target_compile_definitions(channel_test
     PRIVATE
-        HOLOSCAN_CHANNEL_TENSOR_INTERPROCESS_CHILD_EXE="$<TARGET_FILE:channel_tensor_interprocess_child>"
+        HOLOSCAN_CHANNEL_TENSOR_INTERPROCESS_CHILD_EXE="${_channel_tensor_child}"
 )
+unset(_channel_tensor_child)
 add_dependencies(channel_tensor_test
     channel_tensor_interprocess_child
 )
@@ -320,3 +341,15 @@ gtest_discover_tests(channel_tensor_test
     TEST_PREFIX CHANNEL.
     WORKING_DIRECTORY ${holoscan_BINARY_DIR}
 )
+
+# Ship these suites, and the child programs they exec in channel/, when the build
+# opts into installing tests.
+holoscan_install_test_targets(TARGETS channel_test channel_schema_test channel_tensor_test)
+holoscan_install_test_targets(SUBDIRECTORY channel
+    TARGETS
+        channel_catalog_pod_interprocess_child
+        channel_event_wait_child
+        channel_interprocess_child
+        channel_schema_interprocess_child
+        channel_tensor_interprocess_child
+)
