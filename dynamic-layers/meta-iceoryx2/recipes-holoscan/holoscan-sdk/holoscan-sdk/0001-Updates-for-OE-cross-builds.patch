     GLOBAL_TARGETS GTest::gtest GTest::gmock GTest::gtest_main GTest::gmock_main
     CPM_ARGS FIND_PACKAGE_ARGUMENTS "EXACT"
diff --git a/cmake/deps/iceoryx2.cmake b/cmake/deps/iceoryx2.cmake
