+include(CheckCXXSourceCompiles)
+
+# Ask a candidate package what it can do rather than what it is called. The marker
+# this replaces turned away every provider but this exact vendored build.
+function(holomq_iceoryx2_require_sample_handlers cxx_target)
+    set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
+    set(CMAKE_REQUIRED_LIBRARIES ${cxx_target})
+    check_cxx_source_compiles([[
+#include "iox2/sample_released_handler.hpp"
+#include "iox2/sample_replaced_handler.hpp"
+int main() {
+    (void) sizeof(iox2::SampleReleasedHandler);
+    (void) sizeof(iox2::SampleReplacedHandler);
+    return 0;
+}
+]] HOLOMQ_ICEORYX2_HAS_SAMPLE_HANDLERS)
+    if(NOT HOLOMQ_ICEORYX2_HAS_SAMPLE_HANDLERS)
+        message(FATAL_ERROR
+            "The iceoryx2-cxx package HoloMQ found does not provide the publisher "
+            "sample-release and sample-replacement handlers that HoloMQ requires. Apply the "
+            "HoloMQ iceoryx2 patch series to it, or set HOLOMQ_ICEORYX2_PREFIX to an "
+            "installation that carries them."
+        )
+    endif()
+endfunction()
