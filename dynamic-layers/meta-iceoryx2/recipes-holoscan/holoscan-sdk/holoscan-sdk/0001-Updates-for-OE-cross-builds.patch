-    FILES_MATCHING
-        PATTERN "CMakeLists.txt"
-        PATTERN "README.md"
-        PATTERN "*.cmake"
-        PATTERN "*.cpp"
-        PATTERN "*.hpp"
-        PATTERN "*.fbs"
