+# Only a fetched copy lives under the private third-party root; a provider found
+# on the system is an IMPORTED target and keeps the ordinary package root.
+foreach(_holoscan_provider IN ITEMS
+        "fmt|fmt::fmt-header-only" "dlpack|dlpack::dlpack" "Flatbuffers|flatbuffers::flatbuffers")
+    string(REPLACE "|" ";" _holoscan_provider "${_holoscan_provider}")
+    list(GET _holoscan_provider 0 _holoscan_provider_package)
+    list(GET _holoscan_provider 1 _holoscan_provider_target)
+    if(TARGET ${_holoscan_provider_target})
+        get_target_property(_holoscan_provider_imported ${_holoscan_provider_target} IMPORTED)
