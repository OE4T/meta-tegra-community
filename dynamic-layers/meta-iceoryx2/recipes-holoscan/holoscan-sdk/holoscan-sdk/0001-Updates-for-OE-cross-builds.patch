+include(GNUInstallDirs)
+set(HOLOSCAN_BENCHMARKS_INSTALL_DIR "${CMAKE_INSTALL_DATADIR}/benchmark")
+
+# Install each benchmark beside its own sources, keeping the SDK-wide
+# CMAKE_INSTALL_RPATH. Targets come from the buildsystem rather than
+# holoscan-benchmark-targets, which the HoloMQ benchmarks never register with.
+get_property(_holoscan_benchmark_directories DIRECTORY PROPERTY SUBDIRECTORIES)
+foreach(_holoscan_benchmark_directory IN LISTS _holoscan_benchmark_directories)
+    get_property(_holoscan_benchmark_targets
+        DIRECTORY "${_holoscan_benchmark_directory}" PROPERTY BUILDSYSTEM_TARGETS)
+    foreach(_holoscan_benchmark_target IN LISTS _holoscan_benchmark_targets)
+        get_target_property(_holoscan_benchmark_type "${_holoscan_benchmark_target}" TYPE)
+        if(NOT _holoscan_benchmark_type STREQUAL "EXECUTABLE")
+            continue()
+        endif()
+        file(RELATIVE_PATH _holoscan_benchmark_relative_directory
+            "${CMAKE_CURRENT_SOURCE_DIR}" "${_holoscan_benchmark_directory}")
+        install(TARGETS ${_holoscan_benchmark_target}
+            RUNTIME DESTINATION
+                "${HOLOSCAN_BENCHMARKS_INSTALL_DIR}/${_holoscan_benchmark_relative_directory}"
+            COMPONENT holoscan-benchmarks
+        )
+    endforeach()
+endforeach()
+unset(_holoscan_benchmark_directories)
+unset(_holoscan_benchmark_directory)
+unset(_holoscan_benchmark_relative_directory)
+unset(_holoscan_benchmark_target)
+unset(_holoscan_benchmark_targets)
+unset(_holoscan_benchmark_type)
+
+# Named the way HOLOSCAN_INSTALL_EXAMPLE_SOURCE is, and declared here because this
+# directory is also a standalone project, where a parent-only option would read OFF.
+option(HOLOSCAN_INSTALL_BENCHMARK_SOURCE "Install the benchmark source code" ON)
+if(HOLOSCAN_INSTALL_BENCHMARK_SOURCE)
+    install(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/"
+        DESTINATION "${HOLOSCAN_BENCHMARKS_INSTALL_DIR}"
+        COMPONENT holoscan-benchmarks
+        FILES_MATCHING
+            PATTERN "CMakeLists.txt"
+            PATTERN "README.md"
+            PATTERN "*.cmake"
+            PATTERN "*.cpp"
+            PATTERN "*.hpp"
+            PATTERN "*.fbs"
+            PATTERN "*.py"
+            PATTERN "*.sh"
+        PATTERN "__pycache__" EXCLUDE
+    )
+endif()
