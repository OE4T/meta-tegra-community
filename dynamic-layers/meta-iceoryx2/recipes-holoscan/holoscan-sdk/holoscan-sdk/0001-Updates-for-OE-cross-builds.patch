 endif()
 
-set(version 1.17.0)
+set(version 1.18.0)
+
+# rapids_cpm_find below asks for "googletest", which an installed GoogleTest never
+# advertises - it is GTest - so try the real name first. GLOBAL matches the
+# GLOBAL_TARGETS it passes: this runs inside holoscan_add_dependency(), so a scoped
+# imported target would be gone before a test directory links it.
+find_package(GTest ${version} EXACT CONFIG QUIET GLOBAL)
+if(TARGET GTest::gtest
+   AND TARGET GTest::gtest_main
+   AND TARGET GTest::gmock
+   AND TARGET GTest::gmock_main)
+    return()
+endif()
+
